# ==================== Phase 11 新组件 ====================

def _codebook_prefix(code, marker):
    """为码本code添加前缀标记 (保唯一性)"""
    return "{}{}".format(marker, code)


class EncodingDictionary:
    """
    Phase 11 核心: 多级编码词典
    L0: 单符号码(1 Unicode字符) - 极高频领域术语
    L1: 双符号码(2字符) - 高频动作/状态
    L2: 三符号码(3字符) - 中频短语模式
    L3: 短语码(4-6字符) - 完整句式模板

    编码格式: [级别标记][短码]
    标记: . = L0, : = L1, ; = L2, _ = L3
    解码: 标记→查对应级词典→替换回原文
    100% 往返一致性保证
    """

    def __init__(self, domain="1688"):
        self.domain = domain
        # L0: 单符号码 - 极高频术语(1:1映射,单个Unicode字符)
        self.L0 = {
            '网销宝': '₩', '关键词': '☧', '转化率': '☢', '出价': '₸',
            '排名': '♯', '流量': '∾', '爆款': '✦', '询盘': '✆',
            '详情页': '♱', '主图': '◈', '标题': '†', '核心词': '♣',
            '长尾词': '♠', '选品': '♦', '竞品': '☆', 'ROI': '℞',
            '展现': '⊕', '点击': '⊗', '消耗': '⊖', 'PPC': 'π',
            'CPC': 'φ', 'UV': 'µ', 'PV': '∂', 'GMV': 'Ω',
            '客单价': 'ψ', '跳失率': '∇', '收藏': '♥', '加购': '♢',
            '搜索': 'Σ', '预算': '฿', '推广': '‡', '曝光': '☀',
            '点击率': 'λ', '成交': '✓', '店铺': 'Δ', '商品': '∝',
            '类目': 'θ', '属性': 'χ', 'SKU': 'ξ', '品效': 'ζ',
            '差评率': 'η', '复购率': 'β', '响应': 'α', '客服': 'κ',
        }
        self.L0_reverse = {v: k for k, v in self.L0.items()}

        # L1: 双符号码 - 高频动作/状态/数值模式
        self.L1 = {
            '优化': '⌘O', '提升': '⌘↑', '降低': '⌘↓', '增加': '⌘+',
            '减少': '⌘-', '调整': '⌘↔', '分析': '⌘A', '设置': '⌘S',
            '配置': '⌘C', '监控': '⌘M', '排查': '⌘D', '诊断': '⌘X',
            '建议': '⌘!', '控制': '⌘K', '布局': '⌘L', '投放': '⌘P',
            '暂停': '⌘⏸', '加大': '⌘⏩', '覆盖': '⌘≊', '保证': '⌘✓',
            '行业均价': '#AV', '搜索权重': '#SW', '行业均值': '#ME',
            '百分比': '#PC', '倍数': '#ML', '高于': '>≥', '低于': '<≤',
            '以上': '↑↑', '以下': '↓↓', '最佳': '★★', '属于': '∈∈',
            '中等': '≈≈', '区间': '[][]', '不足': '<!', '有潜力': '>★',
        }
        self.L1_reverse = {v: k for k, v in self.L1.items()}

        # L2: 已移除 — 原24条4字码零节省(4→4字符0%压缩率)
        # 这些短语在原编码方案中不贡献任何压缩效益，保留增加词典大小和解码复杂度
        self.L2 = {}
        self.L2_reverse = {}

        # L3: 短语码 - 完整句式模板
        self.L3 = {
            # 网销宝/出价
            '转化率低于1%的关键词建议降低出价或者暂停': 'T3ab',
            '核心词建议出价在行业均价的1.2-1.5倍保证展现量基础': 'T3ef',
            '长尾词出价控制在均价的0.6-0.8倍用低出价获取精准流量': 'T3gh',
            '每日预算分配上核心词占30%长尾词占70%': 'T3ij',
            '核心词占30%长尾词占70%核心词出价高但流量精准': 'T3aa',
            '建议根据ROI动态调整ROI高于3:1的核心词可以适当提高': 'T3bb',
            # 标题优化
            '标题长度建议25-30个汉字包含1个核心词+2-3个长尾词+1个属性词': 'T3cd',
            '搜索权重最高位置在前15个字符': 'T3cc',
            '前15字放核心词获得最高搜索权重后15字放长尾词': 'T3dd',
            # 数据分析
            '转化率2%属于行业中等水平': 'T3kl',
            '跳失率高于70%说明详情页有问题': 'T3mn',
            '停留时长低于30秒说明主图吸引力不足': 'T3op',
            '收藏加购率高于5%说明产品有潜力': 'T3qr',
            '利润率低于30%不建议做快递费超过售价15%的要谨慎': 'T3st',
            '1688平台B2B类目转化率区间一般在1%-5%': 'T3ee',
            '建议通过详情页优化和客服响应速度提升到3%以上': 'T3ff',
            # 爆款/选品
            '爆款评估要看7天销量增速30天复购率和差评率': 'T3gg',
            '增速大于20%且差评率小于3%可加大推广': 'T3hh',
            '选品要看利润率和物流成本': 'T3ii',
            '竞品分析要关注价格带分布找出市场空白价格带': 'T3jj',
            # 询盘/转化
            '询盘转化率提升需要详情页优化产品参数要完整': 'T3kk',
            '响应时间控制在30秒以内': 'T3ll',
            # 通用
            '核心词出价控制在行业均价1.3倍': 'T3mm',
            '核心词出价高但流量精准长尾词出价低但覆盖面广': 'T3nn',
        }
        self.L3_reverse = {v: k for k, v in self.L3.items()}

        # 统计
        self.encode_stats = {'L0_hits': 0, 'L1_hits': 0,
                             'L3_hits': 0, 'total_encoded': 0}
        self.hit_frequency = {}

        # [Phase 12] LZW自适应词典引擎 (替换旧计数阈值扩展)
        # LZW: 第2次重复即注册新码,0延迟,自适应变长模式
        self.lzw_builder = LZWBuilder(initial_dict=None)
        # 注入L0/L1/L3作为初始种子
        all_seeds = {}
        for phrase, code in self.L0.items():
            all_seeds[phrase] = code
        for phrase, code in self.L1.items():
            all_seeds[phrase] = code
        for phrase, code in self.L3.items():
            all_seeds[phrase] = code
        self.lzw_builder.seed_from_phase11(self.L0, self.L1, self.L3)
        # LZW统计
        self.lzw_new_entries_total = 0

        # [Phase 12] 编码域直算引擎
        self.encoded_ops = EncodedDirectOps()

    # 注: track_unmatched() 和 maybe_expand() 已由 LZWBuilder 完全替代
    # LZW引擎在encode时自动完成: 贪心匹配→发现重复→即时注册→无需阈值

    def encode(self, text):
        """
        将文本编码为短码序列 — 去标记符化
        L0: 裸Unicode符号替换(无标记,因符号唯一不会冲突)
        L1: ⌘前缀码直接替换
        L2: ;前缀码直接替换
        L3: _前缀码直接替换
        优先级: L3(最长匹配)→L2→L1→L0
        """
        self.encode_stats['total_encoded'] += 1
        encoded = text
        # ===== Phase 11 编码 =====
        # Step 1: L3 短语码(最长优先) — 前缀 _
        for phrase, code in sorted(self.L3.items(), key=lambda x: -len(x[0])):
            if phrase in encoded:
                encoded = encoded.replace(phrase, _codebook_prefix(code, '_'))
                self.encode_stats['L3_hits'] += 1
                self._record_hit(phrase)
        # Step 2: L1 双符号码 — 前缀 ⌘/#/>/</[
        for phrase, code in sorted(self.L1.items(), key=lambda x: -len(x[0])):
            if phrase in encoded:
                encoded = encoded.replace(phrase, code)
                self.encode_stats['L1_hits'] += 1
                self._record_hit(phrase)
        # Step 3: L0 裸Unicode符号(无标记)
        for phrase, code in sorted(self.L0.items(), key=lambda x: -len(x[0])):
            if phrase in encoded:
                encoded = encoded.replace(phrase, code)
                self.encode_stats['L0_hits'] += 1
                self._record_hit(phrase)
        # ===== Phase 12 LZW自适应补充编码 =====
        # 对编码文本中未被L0/L1/L3覆盖的原文做LZW处理
        lzw_encoded, new_entries = self.lzw_builder.encode(encoded)
        self.lzw_new_entries_total += new_entries
        return lzw_encoded

    def decode(self, encoded_text):
        """将短码序列解码回原文 — 100%还原保证
        跨所有级别按码长降序处理,避免短码破坏长码
        """
        decoded = encoded_text
        # ===== Phase 12: 先解码LZW码(:L{N}) =====
        # LZW码使用:前缀,与L0/L1/L3无冲突
        for code, phrase in sorted(
                self.lzw_builder.lzw_reverse.items(),
                key=lambda x: -len(x[0])):
            if code in decoded:
                decoded = decoded.replace(code, phrase)
        # ===== Phase 11: 解码L0/L1/L3 =====
        # 构建(码->原文)的全局映射,按码长降序排列
        all_codes = []
        # L0: 裸Unicode符号
        for code, phrase in self.L0_reverse.items():
            all_codes.append((code, phrase, len(code)))
        # L1: ⌘/#/>/</ 等前缀标记
        for code, phrase in self.L1_reverse.items():
            all_codes.append((code, phrase, len(code)))
        # L3: _前缀码
        for code, phrase in self.L3_reverse.items():
            marker = _codebook_prefix(code, '_')
            all_codes.append((marker, phrase, len(marker)))

        # 按码长降序处理(最长优先,避免短码破坏长码)
        for code, phrase, _ in sorted(all_codes, key=lambda x: -x[2]):
            if code in decoded:
                decoded = decoded.replace(code, phrase)
        return decoded

    def _record_hit(self, phrase):
        self.hit_frequency[phrase] = self.hit_frequency.get(phrase, 0) + 1

    def get_compression_ratio(self, text, encoded):
        if len(text) == 0:
            return 0
        return 1 - len(encoded) / len(text)

    def get_stats(self):
        total_hits = (self.encode_stats['L0_hits'] + self.encode_stats['L1_hits'] +
                      self.encode_stats['L3_hits'])
        # Phase 12: LZW统计
        lzw_stats = self.lzw_builder.get_stats() if hasattr(self, 'lzw_builder') else {}
        return {
            **self.encode_stats,
            'L0_entries': len(self.L0),
            'L1_entries': len(self.L1),
            'L2_entries': 'removed',
            'L3_entries': len(self.L3),
            'total_entries': len(self.L0) + len(self.L1) + len(self.L3),
            'total_hits': total_hits,
            'top_hits': sorted(self.hit_frequency.items(), key=lambda x: -x[1])[:10],
            # Phase 12 扩展
            'lzw_dict_size': len(self.lzw_builder.lzw_dict) if hasattr(self, 'lzw_builder') else 0,
            'lzw_new_entries': self.lzw_new_entries_total if hasattr(self, 'lzw_new_entries_total') else 0,
            'lzw_hits': lzw_stats.get('lzw_hits', 0),
            'lzw_added': lzw_stats.get('lzw_added', 0),
        }


class CodeBook:
    """Phase 11 码本管理器: 版本控制与码本导出"""
    
    _DEFAULT_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), 
                                 'codebook_snapshot.json')

    def __init__(self, domain="1688"):
        self.domain = domain
        self.versions = {}
        self.current_version = 0

    def save_snapshot(self, dictionary):
        self.current_version += 1
        # [Phase 12] LZW词典快照
        lzw_snap = dictionary.lzw_builder.get_dictionary_snapshot() if hasattr(dictionary, 'lzw_builder') else {}
        snapshot = {
            'version': self.current_version, 'timestamp': time.time(),
            'L0': copy.deepcopy(dictionary.L0),
            'L1': copy.deepcopy(dictionary.L1),
            'L3': copy.deepcopy(dictionary.L3),
            'LZW': lzw_snap,  # LZW词典持久化
            'stats': dictionary.get_stats(),
        }
        self.versions[self.current_version] = snapshot
        return self.current_version

    def export_codebook(self, dictionary):
        return {
            'domain': self.domain, 'version': self.current_version,
            'L0': dictionary.L0, 'L1': dictionary.L1,
            'L3': dictionary.L3,
            'LZW': dictionary.lzw_builder.get_dictionary_snapshot() if hasattr(dictionary, 'lzw_builder') else {},
        }

    def persist(self, filepath=None):
        """将当前码本持久化到JSON文件"""
        path = filepath or self._DEFAULT_PATH
        data = {
            'domain': self.domain,
            'current_version': self.current_version,
            'versions': {
                str(k): self._sanitize(v) for k, v in self.versions.items()
            },
        }
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        return path

    def load_persisted(self, filepath=None):
        """从JSON文件恢复码本(仅恢复最新版本)"""
        path = filepath or self._DEFAULT_PATH
        if not os.path.exists(path):
            return None
        with open(path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        self.domain = data.get('domain', self.domain)
        self.current_version = data.get('current_version', 0)
        versions = data.get('versions', {})
        for k, v in versions.items():
            self.versions[int(k)] = v
        return data

    def restore_dictionary(self, dictionary):
        """将持久化的最新快照恢复到词典中(含LZW)"""
        if not self.versions:
            return False
        latest = self.versions[self.current_version]
        dictionary.L0 = copy.deepcopy(latest['L0'])
        dictionary.L0_reverse = {v: k for k, v in latest['L0'].items()}
        dictionary.L1 = copy.deepcopy(latest['L1'])
        dictionary.L1_reverse = {v: k for k, v in latest['L1'].items()}
        dictionary.L3 = copy.deepcopy(latest['L3'])
        dictionary.L3_reverse = {v: k for k, v in latest['L3'].items()}
        # [Phase 12] 恢复LZW词典
        lzw_snap = latest.get('LZW', {})
        if lzw_snap and hasattr(dictionary, 'lzw_builder'):
            dictionary.lzw_builder.restore_snapshot(lzw_snap)
        return True

    @staticmethod
    def _sanitize(snap):
        """确保快照可JSON序列化(转换set/其他非标准类型)"""
        clean = dict(snap)
        if 'stats' in clean and isinstance(clean['stats'].get('top_hits'), list):
            clean['stats'] = dict(clean['stats'])
            clean['stats']['top_hits'] = [
                [str(k), v] for k, v in clean['stats'].get('top_hits', [])
            ]
        return clean


# ==================== Phase 11 编码增强统一引擎 ====================

class EncodingEnhancedEngine:
    """
    Phase 11 编码增强统一引擎
    在 Phase 10 FederatedUnifiedEngine 外层增加编码词典层

    处理链(7层):
    L0: 跨会话缓存(0T)
    L1: 预测性语义缓存(0T)
    L2: 信号检测(0T)
    L3: 编码词典匹配(L0-L3短码替换,核心创新)
    L4: 编码后自适应压缩+Delta引擎
    L5: 联邦策略增强
    L6: 缓存+统计+自适应扩展
    """

    def __init__(self, user_profile=None):
        # Phase 10 核心引擎
        self.p10 = FederatedUnifiedEngine(user_profile=user_profile or {
            'domain': '1688', 'compression_style': 'aggressive',
            'expertise': 'expert',
        })
        # Phase 11 编码词典组件
        self.encoding_dict = EncodingDictionary(domain="1688")
        self.codebook = CodeBook(domain="1688")
        # 保存初始码本版本
        self.codebook.save_snapshot(self.encoding_dict)
        # 扩展统计
        self.encoding_hits = 0
        self.encoding_savings = 0
        self.decode_verify_errors = 0
        self.decode_verify_total = 0
        # 自动持久化
        self.auto_persist = True

        # 尝试恢复已持久化的码本
        self._try_restore_persisted()

    def _try_restore_persisted(self):
        """尝试从持久化文件恢复码本"""
        try:
            persisted = self.codebook.load_persisted()
            if persisted:
                self.codebook.restore_dictionary(self.encoding_dict)
                print("  [CodeBook] 已恢复码本 v{}, 词典{}条, LZW{}条".format(
                    self.codebook.current_version,
                    self.encoding_dict.get_stats()['total_entries'],
                    len(self.encoding_dict.lzw_builder.lzw_dict) if hasattr(self.encoding_dict, 'lzw_builder') else 0))
        except Exception:
            pass  # 首次运行无持久化文件,静默跳过

    @property
    def cache(self):
        return self.p10.cache

    @property
    def delta(self):
        return self.p10.delta

    @property
    def learner(self):
        return self.p10.learner

    @property
    def stats(self):
        return self.p10.stats

    @property
    def fed_server(self):
        return self.p10.fed_server

    @property
    def strategy_sharer(self):
        return self.p10.strategy_sharer

    @property
    def cross_session_cache(self):
        return self.p10.cross_session_cache

    def register_client(self, client_id, domain="1688"):
        return self.p10.register_client(client_id, domain)

    def federated_train_round(self, scenarios_by_client):
        return self.p10.federated_train_round(scenarios_by_client)

    def process(self, query, response, session_id="default"):
        """增强处理: 编码词典 → Phase 10处理 → 解码验证"""
        original_len = len(response)

        # ===== L0-L2: 利用Phase 10缓存+信号检测 =====
        # 先查缓存/信号(0T路径)
        cross_key = self.p10.cache._hash(query)
        if cross_key in self.p10.cross_session_cache:
            self.p10.stats['cache_hits'] += 1
            return {'tokens': 0, 'output': self.p10.cross_session_cache[cross_key],
                    'source': 'cross_session_cache', 'compressed_len': 0,
                    'original_len': original_len}

        cached = self.p10.cache.get(query, encode_fn=self.encoding_dict.encode)
        if cached is not None:
            self.p10.stats['cache_hits'] += 1
            return {'tokens': 0, 'output': cached, 'source': 'cache_hit',
                    'compressed_len': 0, 'original_len': original_len}

        # [Phase 12 P2] 编码域模糊匹配 — 精确未命中后的第二路径
        fuzzy_result = self.p10.cache.fuzzy_get(
            query,
            similarity_ops=self.encoding_dict.encoded_ops,
            encode_fn=self.encoding_dict.encode,
            threshold=0.5, max_scan=30
        )
        fuzzy_value, fuzzy_score, fuzzy_count = fuzzy_result
        if fuzzy_value is not None:
            self.p10.stats['cache_hits'] += 1
            self.p10.stats['fuzzy_matches'] = self.p10.stats.get('fuzzy_matches', 0) + 1
            self.p10.stats['fuzzy_scan_count'] = self.p10.stats.get('fuzzy_scan_count', 0) + fuzzy_count
            return {'tokens': 0, 'output': fuzzy_value, 'source': 'fuzzy_cache',
                    'compressed_len': 0, 'original_len': original_len}

        content_type = self.p10.learner.detect_type(response)
        if content_type == 'signal':
            self.p10.cache.put(query, '✓', encode_fn=self.encoding_dict.encode)
            self.p10.cross_session_cache[cross_key] = '✓'
            self.p10.stats['signal_hits'] += 1
            return {'tokens': 0, 'output': '✓', 'source': 'signal',
                    'compressed_len': 0, 'original_len': original_len}

        # ===== L3: 编码词典编码(Phase 11核心) =====
        # 先做词典往返验证(确保语义100%可恢复)
        # 注意: 使用临时编码验证,不影响后续流程
        encoded_temp = self.encoding_dict.encode(response)
        self.decode_verify_total += 1
        decoded_check = self.encoding_dict.decode(encoded_temp)
        if decoded_check != response:
            # 词典往返不一致→报告但不回退(后续压缩会处理)
            self.decode_verify_errors += 1

        # 正式编码(使用词典)
        encoded = encoded_temp
        encoding_ratio = self.encoding_dict.get_compression_ratio(response, encoded)

        if encoding_ratio > 0.3:
            self.encoding_hits += 1
            self.encoding_savings += original_len - len(encoded)

        # ===== L4: Phase 10处理(但不重新缓存,因为我们已经有编码结果) =====
        # 调用Phase 10的增强压缩,但传入编码后的文本
        self.p10.stats['total_queries'] += 1

        # [Phase 12] 自适应扩展由LZWBuilder在线完成,无需旧阈值检查
        # 旧track_unmatched/maybe_expand已由LZW引擎自动替换
        expand_count = 0

        # 策略匹配
        strategy_match = self.p10.strategy_sharer.match_scenario(response)
        enhanced_rate = None
        if strategy_match:
            self.p10.stats['strategy_matches'] += 1
            enhanced_rate = strategy_match['params']['optimal_rate']
            distilled_pref = self.p10.learner.user_preferred_rate
            if distilled_pref > enhanced_rate:
                enhanced_rate = min(0.99, distilled_pref)
                self.p10.stats['federated_improvements'] += 1

        # 计算目标压缩率
        base_rate = self.p10.learner.predict(response)
        final_rate = enhanced_rate if (enhanced_rate and enhanced_rate > base_rate) else base_rate

        # 核心优化: 在编码后的文本上执行压缩
        # 编码文本已经更短,所以压缩目标更容易达到
        if encoding_ratio > 0.5:
            # 编码已够激进,直接用编码结果(配合Delta)
            compressed = encoded
        else:
            # 编码不足→在原文基础上应用Phase 10压缩,但考虑编码贡献
            compressed = self.p10._compress_enhanced(encoded, final_rate, strategy_match)

        # Delta引擎
        self.p10.delta.next_turn()
        delta_output = self.p10.delta.compress(compressed)

        # ===== L5: 记录+缓存+联邦 =====
        self.p10.learner.record(original_len, len(delta_output))
        self.p10.cache.put(query, compressed, encode_fn=self.encoding_dict.encode)
        self.p10.cross_session_cache[cross_key] = delta_output
        self.p10.learner.update()

        if strategy_match:
            actual_rate = 1 - len(delta_output) / max(original_len, 1)
            self.p10.strategy_sharer.share_insight('optimal_rate', {
                'scenario': strategy_match['scenario'], 'rate': actual_rate,
            })

        self.p10.session_strategies[session_id] = {
            'rate': final_rate,
            'strategy': strategy_match['scenario'] if strategy_match else 'default',
            'encoding_ratio': round(encoding_ratio, 3),
        }

        # 自动持久化: 每5次处理保存一次
        if self.auto_persist and self.p10.stats['total_queries'] % 5 == 0:
            self.codebook.save_snapshot(self.encoding_dict)
            self.codebook.persist()

        return {
            'tokens': len(delta_output),
            'output': delta_output,
            'source': 'encoding_federated' if strategy_match else 'encoding_adaptive',
            'compressed_len': len(delta_output),
            'original_len': original_len,
            'strategy': strategy_match['scenario'] if strategy_match else None,
            'base_rate': round(base_rate, 4),
            'final_rate': round(final_rate, 4),
            'encoding_ratio': round(encoding_ratio, 4),
        }

    def get_stats(self):
        base = self.p10.get_stats()
        base['encoding_hits'] = self.encoding_hits
        base['encoding_savings'] = self.encoding_savings
        base['decode_verify_errors'] = self.decode_verify_errors
        base['decode_verify_total'] = self.decode_verify_total
        base['dict_stats'] = self.encoding_dict.get_stats()
        base['codebook_versions'] = self.codebook.current_version
        base['auto_expansions'] = len(self.encoding_dict._expansion_log)
        base['expansion_log'] = self.encoding_dict._expansion_log[-5:]  # 最近5条
        return base


