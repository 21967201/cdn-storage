         '保证成交',
         lambda t: engine.encoding_dict.decode(
             engine.encoding_dict.encode(t)) == '保证成交'),
        # 2) 多条L1+L0混合
        ('交叉_优化成交',
         '优化保证成交',
         lambda t: engine.encoding_dict.decode(
             engine.encoding_dict.encode(t)) == '优化保证成交'),
        # 3) 空字符串
        ('空字符', '',
         lambda t: engine.encoding_dict.decode(
             engine.encoding_dict.encode(t)) == ''),
        # 4) 单字符
        ('单字符', '好',
         lambda t: engine.encoding_dict.decode(
             engine.encoding_dict.encode(t)) == '好'),
        # 5) 特殊符号
        ('特殊符号', 'ROI>3:1',
         lambda t: engine.encoding_dict.decode(
             engine.encoding_dict.encode(t)) == 'ROI>3:1'),
        # 6) 纯数字混合
        ('数字', '价格12.5元',
         lambda t: engine.encoding_dict.decode(
             engine.encoding_dict.encode(t)) == '价格12.5元'),
        # 7) 重复L0
        ('双L0', '网销宝网销宝',
         lambda t: engine.encoding_dict.decode(
             engine.encoding_dict.encode(t)) == '网销宝网销宝'),
    ]
    for name, test_text, validator in edge_tests:
        edge_total += 1
        enc = engine.encoding_dict.encode(test_text)
        dec = engine.encoding_dict.decode(enc)
        result = dec == test_text
        if result:
            edge_pass += 1
        status = "✓" if result else "✗"
        print("  {} {}: 原文'{}'→编码'{}'→解码一致={}".format(
            status, name, test_text[:20], enc[:30], result))
    print("  边界场景通过率: {}/{} ({:.0f}%)".format(
        edge_pass, edge_total, edge_pass / edge_total * 100))

    print("\n" + "=" * 70)
    print("Phase 11 验证完成")
    print("=" * 70)

    return {
        'total_original': total_original, 'total_compressed': total_compressed,
        'total_saving': total_saving,
        'p9_saving': p9_saving, 'p10_saving': p10_saving,
        'improvement_p9': improvement_p9, 'improvement_p10': improvement_p10,
        'results': results, 'stats': engine.get_stats(),
        'fidelity': "{}/{}".format(f_pass, len(fidelity_tests)),
        'edge_pass': edge_pass, 'edge_total': edge_total,
    }


if __name__ == '__main__':
    run_verification()